<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>100Days Kidz Spoken English | SNK IT Institute</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#050505;
      color:#fff;
      line-height:1.6;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    .container{
      width:min(1180px,92%);
      margin:auto;
    }

    /* ================= HEADER ================= */

    .header{
      position:sticky;
      top:0;
      z-index:9999;
      background:rgba(5,5,5,.92);
      backdrop-filter:blur(18px);
      border-bottom:1px solid #1d1d1d;
    }

    .nav{
      min-height:78px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:25px;
    }

    .brand img{
      width:120px;
      display:block;
    }

    .menu{
      display:flex;
      align-items:center;
      gap:25px;
    }

    .menu a{
      color:#aaa;
      font-size:14px;
      transition:.3s;
    }

    .menu a:hover{
      color:#b7ff00;
    }

    .nav-button{
      background:#b7ff00;
      color:#050505;
      padding:10px 17px;
      border-radius:8px;
      font-size:13px;
      font-weight:800;
    }

    /* ================= HERO ================= */

    .hero{
      min-height:calc(100vh - 78px);
      display:flex;
      align-items:center;
      background:
        radial-gradient(
          circle at 80% 40%,
          rgba(183,255,0,.13),
          transparent 30%
        ),
        #050505;
      overflow:hidden;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:70px;
      align-items:center;
      padding:90px 0;
    }

    .badge{
      display:inline-block;
      padding:8px 14px;
      margin-bottom:22px;
      color:#b7ff00;
      background:rgba(183,255,0,.07);
      border:1px solid rgba(183,255,0,.25);
      border-radius:50px;
      font-size:11px;
      font-weight:800;
      letter-spacing:1px;
    }

    h1{
      font-size:clamp(45px,6vw,76px);
      line-height:1.05;
      letter-spacing:-3px;
      margin-bottom:24px;
    }

    h1 span{
      color:#b7ff00;
    }

    .hero-text{
      color:#999;
      font-size:17px;
      line-height:1.8;
      max-width:650px;
      margin-bottom:30px;
    }

    .buttons{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
    }

    .btn{
      display:inline-flex;
      justify-content:center;
      align-items:center;
      padding:14px 23px;
      border-radius:9px;
      font-size:14px;
      font-weight:800;
      transition:.3s;
    }

    .primary{
      background:#b7ff00;
      color:#050505;
    }

    .primary:hover{
      transform:translateY(-3px);
      box-shadow:0 12px 30px rgba(183,255,0,.2);
    }

    .secondary{
      border:1px solid #333;
      color:#fff;
    }

    .secondary:hover{
      border-color:#b7ff00;
      color:#b7ff00;
    }

    /* ================= HERO IMAGE ================= */

    .hero-image{
      display:flex;
      justify-content:center;
      align-items:center;
    }

    .hero-image img{
      width:min(500px,100%);
      max-height:500px;
      object-fit:contain;
      display:block;
      filter:drop-shadow(0 25px 60px rgba(183,255,0,.08));
    }

    /* ================= SECTION ================= */

    .section{
      padding:100px 0;
    }

    .section-title{
      max-width:700px;
      margin-bottom:45px;
    }

    .section-title small{
      display:block;
      color:#b7ff00;
      font-size:11px;
      font-weight:800;
      letter-spacing:2px;
      margin-bottom:12px;
    }

    .section-title h2{
      font-size:45px;
      line-height:1.1;
      letter-spacing:-2px;
      margin-bottom:15px;
    }

    .section-title h2 span{
      color:#b7ff00;
    }

    .section-title p{
      color:#888;
      font-size:15px;
    }

    /* ================= OVERVIEW ================= */

    .overview{
      background:#080808;
      border-top:1px solid #181818;
      border-bottom:1px solid #181818;
    }

    .overview-grid{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }

    .info-card{
      background:#101010;
      border:1px solid #222;
      border-radius:16px;
      padding:28px;
    }

    .info-icon{
      font-size:28px;
      margin-bottom:15px;
    }

    .info-card h3{
      font-size:19px;
      margin-bottom:8px;
    }

    .info-card p{
      color:#858585;
      font-size:13px;
      line-height:1.8;
    }

    /* ================= WHAT YOU LEARN ================= */

    .learn-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:15px;
    }

    .learn-item{
      padding:20px;
      background:#0b0b0b;
      border:1px solid #202020;
      border-radius:12px;
      color:#bbb;
      font-size:14px;
    }

    .learn-item span{
      color:#b7ff00;
      font-weight:bold;
      margin-right:8px;
    }

    /* ================= COURSE DETAILS ================= */

    .details{
      background:#080808;
    }

    .details-box{
      display:grid;
      grid-template-columns:repeat(4,1fr);
      border:1px solid #222;
      border-radius:16px;
      overflow:hidden;
    }

    .detail{
      padding:25px;
      background:#0c0c0c;
      border-right:1px solid #222;
    }

    .detail:last-child{
      border-right:0;
    }

    .detail small{
      color:#666;
      display:block;
      margin-bottom:6px;
      font-size:11px;
    }

    .detail strong{
      color:#b7ff00;
      font-size:20px;
    }

    /* ================= PRICE ================= */

    .price-section{
      text-align:center;
      background:#050505;
    }

    .price-box{
      max-width:620px;
      margin:auto;
      padding:45px 30px;
      background:
        linear-gradient(
          145deg,
          rgba(183,255,0,.08),
          #0b0b0b
        );
      border:1px solid rgba(183,255,0,.22);
      border-radius:20px;
    }

    .old-price{
      color:#555;
      font-size:17px;
      margin-bottom:5px;
    }

    .new-price{
      color:#b7ff00;
      font-size:48px;
      font-weight:900;
      margin-bottom:10px;
    }

    .offer-text{
      color:#888;
      font-size:14px;
      margin-bottom:25px;
    }

    /* ================= CTA ================= */

    .cta{
      padding:100px 0;
      text-align:center;
      background:
        radial-gradient(
          circle at center,
          rgba(183,255,0,.12),
          transparent 45%
        ),
        #050505;
    }

    .cta h2{
      font-size:clamp(38px,5vw,62px);
      line-height:1.05;
      letter-spacing:-2px;
      margin-bottom:18px;
    }

    .cta h2 span{
      color:#b7ff00;
    }

    .cta p{
      max-width:600px;
      margin:0 auto 28px;
      color:#888;
      font-size:15px;
    }

    .cta .buttons{
      justify-content:center;
    }

    /* ================= FOOTER ================= */

    .footer{
      padding:40px 0;
      border-top:1px solid #1b1b1b;
      color:#666;
      font-size:13px;
    }

    .footer-inner{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:20px;
    }

    .footer-brand{
      color:#fff;
      font-size:18px;
      font-weight:800;
    }

    .footer-brand span{
      color:#b7ff00;
    }

    /* ================= RESPONSIVE ================= */

    @media(max-width:900px){

      .menu{
        display:none;
      }

      .hero-grid{
        grid-template-columns:1fr;
        text-align:center;
        gap:40px;
      }

      .hero-text{
        margin-left:auto;
        margin-right:auto;
      }

      .buttons{
        justify-content:center;
      }

      .hero-image img{
        width:380px;
      }

      .overview-grid{
        grid-template-columns:1fr;
      }

      .details-box{
        grid-template-columns:repeat(2,1fr);
      }

      .detail:nth-child(2){
        border-right:0;
      }

      .detail:nth-child(3),
      .detail:nth-child(4){
        border-top:1px solid #222;
      }

    }

    @media(max-width:600px){

      .container{
        width:90%;
      }

      .nav{
        min-height:70px;
      }

      .brand img{
        width:105px;
      }

      .nav-button{
        padding:9px 13px;
        font-size:11px;
      }

      .hero-grid{
        padding:70px 0;
      }

      h1{
        font-size:43px;
        letter-spacing:-2px;
      }

      .hero-text{
        font-size:14px;
      }

      .btn{
        width:100%;
      }

      .buttons{
        width:100%;
      }

      .hero-image img{
        width:300px;
      }

      .section{
        padding:75px 0;
      }

      .section-title h2{
        font-size:35px;
      }

      .learn-grid{
        grid-template-columns:1fr;
      }

      .details-box{
        grid-template-columns:1fr;
      }

      .detail,
      .detail:nth-child(2),
      .detail:nth-child(3),
      .detail:nth-child(4){
        border-right:0;
        border-top:1px solid #222;
      }

      .detail:first-child{
        border-top:0;
      }

      .new-price{
        font-size:40px;
      }

      .footer-inner{
        flex-direction:column;
        align-items:flex-start;
      }

    }
  </style>
</head>

