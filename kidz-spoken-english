       CTA
    ========================= */

    .cta{
      padding:100px 0;

      text-align:center;

      background:#080808;

      border-top:1px solid #191919;
    }

    .cta h2{
      font-size:clamp(38px,6vw,62px);

      line-height:1.1;

      letter-spacing:-2px;

      margin-bottom:18px;
    }

    .cta h2 span{
      color:#b7ff00;
    }

    .cta p{
      max-width:600px;

      margin:0 auto 28px;

      color:#888;

      font-size:15px;
    }

    .cta-buttons{
      display:flex;

      justify-content:center;

      flex-wrap:wrap;

      gap:12px;
    }


    /* =========================
       FOOTER
    ========================= */

    .footer{
      padding:35px 0;

      background:#050505;

      border-top:1px solid #1b1b1b;
    }

    .footer-inner{
      display:flex;

      justify-content:space-between;

      align-items:center;

      gap:20px;
    }

    .footer-brand{
      font-size:18px;

      font-weight:800;
    }

    .footer-brand span{
      color:#b7ff00;
    }

    .footer p{
      color:#666;

      font-size:12px;
    }


    /* =========================
       RESPONSIVE
    ========================= */

    @media(max-width:900px){

      .course-hero-grid{
        grid-template-columns:1fr;

        text-align:center;
      }

      .course-hero p{
        margin-left:auto;
        margin-right:auto;
      }

      .buttons{
        justify-content:center;
      }

      .hero-course-image{
        order:-1;
      }

      .hero-course-image img{
        max-width:380px;
      }

      .module-grid{
        grid-template-columns:
          repeat(2,1fr);
      }

    }


    @media(max-width:700px){

      .nav{
        min-height:68px;
      }

      .brand img{
        width:100px;
      }

      .menu{
        display:none;
      }

      .nav-button{
        padding:9px 12px;
        font-size:11px;
      }

      .course-hero{
        padding:65px 0;
      }

      .course-hero h1{
        font-size:43px;
        letter-spacing:-2px;
      }

      .course-hero p{
        font-size:14px;
      }

      .btn{
        width:100%;
      }

      .info-grid{
        grid-template-columns:
          repeat(2,1fr);
      }

      .info-box{
        border-bottom:1px solid #1c1c1c;
      }

      .info-box:nth-child(2){
        border-right:0;
      }

      .info-box:nth-child(3){
        border-bottom:0;
      }

      .info-box:nth-child(4){
        border-right:0;
        border-bottom:0;
      }

      .section{
        padding:70px 0;
      }

      .overview-grid{
        grid-template-columns:1fr;
      }

      .learn-list{
        grid-template-columns:1fr;
      }

      .module-grid{
        grid-template-columns:1fr;
      }

      .price-card{
        padding:35px 22px;
      }

      .price-card h2{
        font-size:42px;
      }

      .cta{
        padding:75px 0;
      }

      .cta-buttons{
        flex-direction:column;
      }

      .footer-inner{
        flex-direction:column;

        align-items:flex-start;
      }

    }

  </style>

</head>


