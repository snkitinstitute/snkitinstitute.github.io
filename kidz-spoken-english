<!DOCTYPE html>
<html lang="bn">
<head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>100Days Kidz Spoken English | SNK IT Institute</title>

  <meta
    name="description"
    content="100Days Kidz Spoken English — Kidsদের English Speaking, Vocabulary, Pronunciation ও Communication Skill Development Program."
  >

  <style>

    /* =====================================================
       RESET
    ===================================================== */

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#050505;
      color:#fff;
      line-height:1.6;
      overflow-x:hidden;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    img{
      max-width:100%;
      display:block;
    }

    button,
    input{
      font:inherit;
    }

    .container{
      width:min(1180px,92%);
      margin:auto;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    .header{
      position:sticky;
      top:0;
      z-index:9999;

      background:rgba(5,5,5,.94);

      backdrop-filter:blur(18px);
      -webkit-backdrop-filter:blur(18px);

      border-bottom:1px solid rgba(255,255,255,.08);
    }

    .nav{
      min-height:82px;

      display:flex;
      align-items:center;
      justify-content:space-between;

      gap:25px;
    }

    .brand{
      display:flex;
      align-items:center;
      flex-shrink:0;
    }

    .brand img{
      width:120px;
      height:auto;
    }

    .menu{
      display:flex;
      align-items:center;
      gap:25px;
    }

    .menu a{
      color:#aaa;
      font-size:14px;
      transition:.3s;
    }

    .menu a:hover,
    .menu a.active{
      color:#b7ff00;
    }

    .header-actions{
      display:flex;
      align-items:center;
      gap:10px;
      flex-shrink:0;
    }

    .offer{
      color:#b7ff00;

      border:1px solid rgba(183,255,0,.25);

      background:rgba(183,255,0,.06);

      padding:9px 13px;

      border-radius:8px;

      font-size:12px;
      font-weight:700;
    }

    .nav-button{
      background:#b7ff00;
      color:#050505;

      padding:10px 17px;

      border-radius:8px;

      font-size:13px;
      font-weight:800;

      transition:.3s;
    }

    .nav-button:hover{
      transform:translateY(-2px);

      box-shadow:
        0 10px 30px
        rgba(183,255,0,.2);
    }


    /* =====================================================
       HERO
    ===================================================== */

    .course-hero{
      position:relative;

      overflow:hidden;

      background:
        radial-gradient(
          circle at 78% 40%,
          rgba(183,255,0,.14),
          transparent 30%
        ),
        radial-gradient(
          circle at 10% 80%,
          rgba(183,255,0,.06),
          transparent 25%
        ),
        #050505;
    }

    .course-hero::before{
      content:"";

      position:absolute;

      width:600px;
      height:600px;

      right:-300px;
      top:50%;

      transform:translateY(-50%);

      border:1px solid rgba(183,255,0,.07);

      border-radius:50%;
    }

    .course-hero::after{
      content:"";

      position:absolute;

      width:400px;
      height:400px;

      right:-200px;
      top:50%;

      transform:translateY(-50%);

      border:1px solid rgba(183,255,0,.04);

      border-radius:50%;
    }

    .course-hero-grid{
      position:relative;

      z-index:2;

      min-height:650px;

      display:grid;

      grid-template-columns:
        1fr
        1fr;

      align-items:center;

      gap:65px;

      padding:90px 0;
    }


    /* =====================================================
       HERO CONTENT
    ===================================================== */

    .course-content small{
      display:block;

      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:2px;

      margin-bottom:18px;
    }

    .course-badge{
      display:inline-flex;

      align-items:center;

      gap:8px;

      color:#b7ff00;

      background:rgba(183,255,0,.06);

      border:1px solid rgba(183,255,0,.25);

      padding:8px 13px;

      border-radius:30px;

      font-size:11px;

      font-weight:800;

      margin-bottom:22px;
    }

    .course-badge span{
      width:7px;
      height:7px;

      flex-shrink:0;

      border-radius:50%;

      background:#b7ff00;

      box-shadow:
        0 0 12px #b7ff00;
    }

    .course-content h1{
      font-size:
        clamp(42px,6vw,72px);

      line-height:1.05;

      letter-spacing:-3px;

      margin-bottom:22px;
    }

    .course-content h1 span{
      color:#b7ff00;
    }

    .course-description{
      max-width:620px;

      color:#929292;

      font-size:16px;

      line-height:1.85;

      margin-bottom:30px;
    }


    /* =====================================================
       HERO BUTTONS
    ===================================================== */

    .hero-buttons{
      display:flex;

      flex-wrap:wrap;

      gap:12px;

      margin-bottom:30px;
    }

    .btn{
      display:inline-flex;

      align-items:center;
      justify-content:center;

      padding:14px 22px;

      border-radius:9px;

      font-size:14px;

      font-weight:800;

      transition:.3s;
    }

    .primary{
      background:#b7ff00;
      color:#050505;
    }

    .primary:hover{
      transform:translateY(-3px);

      box-shadow:
        0 12px 35px
        rgba(183,255,0,.2);
    }

    .secondary{
      border:1px solid #333;
      color:#fff;
    }

    .secondary:hover{
      border-color:#b7ff00;
      color:#b7ff00;
    }


    /* =====================================================
       HERO META
    ===================================================== */

    .course-meta{
      display:flex;

      flex-wrap:wrap;

      gap:10px;
    }

    .meta-box{
      padding:12px 15px;

      background:#0c0c0c;

      border:1px solid #222;

      border-radius:9px;
    }

    .meta-box span{
      display:block;

      color:#666;

      font-size:10px;

      margin-bottom:3px;
    }

    .meta-box strong{
      color:#fff;

      font-size:13px;
    }


    /* =====================================================
       HERO VISUAL
       FIXED — FRAME USED ONLY ONCE
    ===================================================== */

    .course-visual{
      position:relative;

      min-height:500px;

      display:flex;

      align-items:center;

      justify-content:center;
    }

    .course-frame{
      position:relative;

      z-index:2;

      width:100%;

      max-width:520px;

      height:auto;

      filter:
        drop-shadow(
          0 0 35px
          rgba(183,255,0,.13)
        );

      transition:.4s;
    }

    .course-visual:hover .course-frame{
      transform:translateY(-5px) scale(1.015);
    }

    /*
       Decorative glow behind image
    */

    .course-visual::before{
      content:"";

      position:absolute;

      width:360px;
      height:360px;

      background:
        radial-gradient(
          circle,
          rgba(183,255,0,.12),
          transparent 68%
        );

      border-radius:50%;

      z-index:0;
    }

    /*
       Decorative ring
    */

    .course-visual::after{
      content:"";

      position:absolute;

      width:440px;
      height:440px;

      border:
        1px solid
        rgba(183,255,0,.07);

      border-radius:50%;

      z-index:1;
    }


    /* =====================================================
       OFFER BAR
    ===================================================== */

    .offer-bar{
      background:#090909;

      border-top:1px solid #1b1b1b;
      border-bottom:1px solid #1b1b1b;
    }

    .offer-grid{
      display:grid;

      grid-template-columns:
        repeat(4,1fr);
    }

    .offer-item{
      padding:25px 15px;

      text-align:center;

      border-right:1px solid #1b1b1b;
    }

    .offer-item:last-child{
      border-right:0;
    }

    .offer-item strong{
      display:block;

      color:#b7ff00;

      font-size:22px;

      margin-bottom:3px;
    }

    .offer-item span{
      color:#777;

      font-size:12px;
    }


    /* =====================================================
       COMMON SECTION
    ===================================================== */

    .section{
      padding:100px 0;
    }

    .section-header{
      max-width:750px;

      margin-bottom:50px;
    }

    .section-header small{
      display:block;

      color:#b7ff00;

      font-size:12px;

      font-weight:800;

      letter-spacing:2px;

      margin-bottom:13px;
    }

    .section-header h2{
      font-size:
        clamp(36px,5vw,58px);

      line-height:1.08;

      letter-spacing:-2px;

      margin-bottom:16px;
    }

    .section-header h2 span{
      color:#b7ff00;
    }

    .section-header p{
      color:#858585;

      font-size:15px;

      line-height:1.8;
    }


    /* =====================================================
       ABOUT COURSE
    ===================================================== */

    .about-course{
      background:#050505;
    }

    .about-grid{
      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:20px;
    }

    .about-card{
      padding:32px;

      background:#0b0b0b;

      border:1px solid #202020;

      border-radius:18px;

      transition:.3s;
    }

    .about-card:hover{
      border-color:
        rgba(183,255,0,.35);

      transform:translateY(-4px);
    }

    .about-icon{
      width:55px;
      height:55px;

      display:grid;

      place-items:center;

      background:rgba(183,255,0,.08);

      border-radius:14px;

      font-size:25px;

      margin-bottom:20px;
    }

    .about-card h3{
      font-size:22px;

      margin-bottom:12px;
    }

    .about-card p{
      color:#858585;

      font-size:14px;

      line-height:1.8;
    }


    /* =====================================================
       LEARNING
    ===================================================== */

    .learning{
      background:#080808;
    }

    .learning-grid{
      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:15px;
    }

    .learning-item{
      display:flex;

      align-items:flex-start;

      gap:15px;

      padding:20px;

      background:#101010;

      border:1px solid #222;

      border-radius:13px;

      transition:.3s;
    }

    .learning-item:hover{
      border-color:
        rgba(183,255,0,.35);

      transform:translateY(-3px);
    }

    .check{
      flex-shrink:0;

      width:30px;
      height:30px;

      display:grid;

      place-items:center;

      color:#050505;

      background:#b7ff00;

      border-radius:50%;

      font-size:14px;

      font-weight:900;
    }

    .learning-item h3{
      font-size:15px;

      margin-bottom:4px;
    }

    .learning-item p{
      color:#777;

      font-size:12px;

      line-height:1.6;
    }


    /* =====================================================
       COURSE STRUCTURE
    ===================================================== */

    .structure{
      background:#050505;
    }

    .timeline{
      position:relative;

      max-width:850px;
    }

    .timeline::before{
      content:"";

      position:absolute;

      left:20px;

      top:10px;
      bottom:10px;

      width:1px;

      background:#2a2a2a;
    }

    .timeline-item{
      position:relative;

      display:flex;

      gap:25px;

      padding-bottom:35px;
    }

    .timeline-item:last-child{
      padding-bottom:0;
    }

    .timeline-number{
      position:relative;

      z-index:2;

      flex-shrink:0;

      width:41px;
      height:41px;

      display:grid;

      place-items:center;

      color:#050505;

      background:#b7ff00;

      border-radius:50%;

      font-size:13px;

      font-weight:900;
    }

    .timeline-content{
      padding:5px 0;
    }

    .timeline-content h3{
      font-size:19px;

      margin-bottom:7px;
    }

    .timeline-content p{
      color:#777;

      font-size:13px;

      line-height:1.75;
    }


    /* =====================================================
       ADMISSION
    ===================================================== */

    .admission{
      background:#080808;
    }

    .admission-box{
      display:grid;

      grid-template-columns:
        1fr
        1fr;

      gap:30px;

      padding:45px;

      background:
        radial-gradient(
          circle at 90% 10%,
          rgba(183,255,0,.10),
          transparent 35%
        ),
        #0d0d0d;

      border:1px solid #252525;

      border-radius:22px;
    }

    .admission-content small{
      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:2px;
    }

    .admission-content h2{
      font-size:42px;

      line-height:1.1;

      margin:12px 0 15px;
    }

    .admission-content p{
      color:#858585;

      font-size:14px;

      line-height:1.8;
    }

    .price-box{
      display:flex;

      flex-direction:column;

      justify-content:center;

      padding:30px;

      background:#080808;

      border:1px solid #222;

      border-radius:16px;

      text-align:center;
    }

    .regular{
      color:#555;

      font-size:14px;

      margin-bottom:3px;
    }

    .regular del{
      text-decoration:line-through;
    }

    .offer-price{
      color:#b7ff00;

      font-size:48px;

      font-weight:900;

      line-height:1.1;

      margin-bottom:8px;
    }

    .limited{
      color:#777;

      font-size:12px;

      margin-bottom:20px;
    }

    .price-box .btn{
      width:100%;
    }


    /* =====================================================
       FAQ
    ===================================================== */

    .faq{
      background:#050505;
    }

    .faq-list{
      max-width:850px;
    }

    .faq-item{
      margin-bottom:10px;

      padding:22px;

      background:#0c0c0c;

      border:1px solid #202020;

      border-radius:12px;
    }

    .faq-item h3{
      color:#fff;

      font-size:16px;

      margin-bottom:7px;
    }

    .faq-item p{
      color:#777;

      font-size:13px;

      line-height:1.75;
    }


    /* =====================================================
       CTA
    ===================================================== */

    .cta{
      padding:105px 0;

      text-align:center;

      background:
        radial-gradient(
          circle at center,
          rgba(183,255,0,.13),
          transparent 45%
        ),
        #050505;

      border-top:1px solid #1b1b1b;
    }

    .cta small{
      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:2px;
    }

    .cta h2{
      font-size:
        clamp(40px,6vw,68px);

      line-height:1.05;

      letter-spacing:-3px;

      margin:15px 0 18px;
    }

    .cta h2 span{
      color:#b7ff00;
    }

    .cta p{
      max-width:600px;

      margin:0 auto 28px;

      color:#858585;

      font-size:15px;
    }

    .cta-buttons{
      display:flex;

      justify-content:center;

      gap:12px;

      flex-wrap:wrap;
    }


    /* =====================================================
       FOOTER
    ===================================================== */

    .footer{
      padding:40px 0;

      background:#050505;

      border-top:1px solid #1b1b1b;
    }

    .footer-inner{
      display:flex;

      justify-content:space-between;

      align-items:center;

      gap:20px;
    }

    .footer-brand{
      color:#fff;

      font-size:18px;

      font-weight:800;
    }

    .footer-brand span{
      color:#b7ff00;
    }

    .footer-tagline{
      color:#666;

      font-size:12px;
    }

    .copyright{
      color:#666;

      font-size:12px;

      text-align:right;
    }


    /* =====================================================
       TABLET
    ===================================================== */

    @media(max-width:950px){

      .menu{
        gap:15px;
      }

      .offer{
        display:none;
      }

      .course-hero-grid{
        grid-template-columns:1fr;

        text-align:center;

        gap:35px;
      }

      .course-description{
        margin-left:auto;
        margin-right:auto;
      }

      .hero-buttons{
        justify-content:center;
      }

      .course-meta{
        justify-content:center;
      }

      .course-visual{
        min-height:430px;
      }

      .about-grid{
        grid-template-columns:1fr;
      }

      .admission-box{
        grid-template-columns:1fr;
      }

    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media(max-width:700px){

      .container{
        width:90%;
      }

      /* HEADER */

      .nav{
        min-height:70px;
      }

      .brand img{
        width:105px;
      }

      .menu{
        display:none;
      }

      .header-actions{
        margin-left:auto;
      }

      .nav-button{
        padding:9px 13px;

        font-size:11px;
      }


      /* HERO */

      .course-hero-grid{
        min-height:auto;

        padding:70px 0 55px;
      }

      .course-badge{
        font-size:10px;

        padding:7px 11px;
      }

      .course-content small{
        font-size:9px;

        letter-spacing:1.5px;
      }

      .course-content h1{
        font-size:45px;

        letter-spacing:-2px;
      }

      .course-description{
        font-size:14px;

        line-height:1.75;
      }

      .hero-buttons{
        flex-direction:column;
      }

      .hero-buttons .btn{
        width:100%;
      }

      .course-meta{
        display:grid;

        grid-template-columns:
          repeat(2,1fr);

        width:100%;
      }

      .meta-box{
        text-align:center;
      }


      /* VISUAL */

      .course-visual{
        min-height:330px;
      }

      .course-frame{
        max-width:390px;
      }

      .course-visual::before{
        width:280px;
        height:280px;
      }

      .course-visual::after{
        width:330px;
        height:330px;
      }


      /* OFFER */

      .offer-grid{
        grid-template-columns:
          repeat(2,1fr);
      }

      .offer-item{
        padding:20px 10px;

        border-bottom:1px solid #1b1b1b;
      }

      .offer-item:nth-child(2){
        border-right:0;
      }

      .offer-item:nth-child(3),
      .offer-item:nth-child(4){
        border-bottom:0;
      }

      .offer-item:nth-child(4){
        border-right:0;
      }


      /* SECTION */

      .section{
        padding:75px 0;
      }

      .section-header{
        margin-bottom:35px;
      }

      .section-header h2{
        font-size:36px;

        letter-spacing:-1.5px;
      }


      /* LEARNING */

      .learning-grid{
        grid-template-columns:1fr;
      }

      .learning-item{
        padding:17px;
      }


      /* ADMISSION */

      .admission-box{
        padding:25px;

        gap:25px;
      }

      .admission-content h2{
        font-size:34px;
      }

      .offer-price{
        font-size:42px;
      }


      /* CTA */

      .cta{
        padding:75px 0;
      }

      .cta h2{
        font-size:42px;

        letter-spacing:-2px;
      }

      .cta-buttons{
        flex-direction:column;
      }

      .cta-buttons .btn{
        width:100%;
      }


      /* FOOTER */

      .footer-inner{
        flex-direction:column;

        align-items:flex-start;
      }

      .copyright{
        text-align:left;
      }

    }


    /* =====================================================
       VERY SMALL MOBILE
    ===================================================== */

    @media(max-width:400px){

      .course-content h1{
        font-size:39px;
      }

      .course-meta{
        grid-template-columns:1fr;
      }

      .course-visual{
        min-height:290px;
      }

      .course-frame{
        max-width:330px;
      }

      .course-visual::before{
        width:230px;
        height:230px;
      }

      .course-visual::after{
        width:270px;
        height:270px;
      }

      .offer-grid{
        grid-template-columns:1fr;
      }

      .offer-item,
      .offer-item:nth-child(3),
      .offer-item:nth-child(4){
        border-right:0;

        border-bottom:1px solid #1b1b1b;
      }

      .offer-item:last-child{
        border-bottom:0;
      }

    }

  </style>

</head>


<body>


  <!-- =====================================================
       HEADER
  ===================================================== -->

  <header class="header">

    <div class="container nav">

      <a
        href="index.html"
        class="brand"
      >

        <img
          src="https://raw.githubusercontent.com/snkitinstitute/AssetsandProducts/main/snk-it-institute-logo.svg"
          alt="SNK IT Institute"
        >

      </a>


      <nav class="menu">

        <a href="index.html">
          হোম
        </a>

        <a
          href="courses.html"
          class="active"
        >
          কোর্সসমূহ
        </a>

        <a href="about.html">
          আমাদের সম্পর্কে
        </a>

        <a href="contact.html">
          যোগাযোগ
        </a>

      </nav>


      <div class="header-actions">

        <a
          href="courses.html"
          class="offer"
        >
          🎁 Special Offer
        </a>

        <a
          href="admission.html"
          class="nav-button"
        >
          ভর্তি করুন →
        </a>

      </div>

    </div>

  </header>



  <!-- =====================================================
       MAIN
  ===================================================== -->

  <main>


    <!-- ===================================================
         HERO
    =================================================== -->

    <section class="course-hero">

      <div class="container">

        <div class="course-hero-grid">


          <!-- CONTENT -->

          <div class="course-content">

            <div class="course-badge">

              <span></span>

              100 DAYS KIDS PROGRAM

            </div>


            <small>
              COMMUNICATION • CONFIDENCE • ENGLISH
            </small>


            <h1>

              100Days

              <br>

