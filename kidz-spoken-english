  <style>

    /* ================================
       RESET
    ================================= */

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#050505;
      color:#fff;
      line-height:1.6;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    img{
      max-width:100%;
      display:block;
    }

    .container{
      width:min(1180px,92%);
      margin:auto;
    }


    /* ================================
       HEADER
    ================================= */

    .header{
      position:sticky;
      top:0;
      z-index:999;

      background:rgba(5,5,5,.92);
      backdrop-filter:blur(18px);

      border-bottom:1px solid #1d1d1d;
    }

    .nav{
      min-height:82px;

      display:flex;
      align-items:center;
      justify-content:space-between;

      gap:25px;
    }

    .brand img{
      width:120px;
    }

    .menu{
      display:flex;
      align-items:center;
      gap:25px;
    }

    .menu a{
      color:#aaa;
      font-size:14px;
      transition:.3s;
    }

    .menu a:hover{
      color:#b7ff00;
    }

    .nav-button{
      background:#b7ff00;
      color:#050505;

      padding:10px 17px;

      border-radius:8px;

      font-size:13px;
      font-weight:800;

      transition:.3s;
    }

    .nav-button:hover{
      transform:translateY(-2px);
      box-shadow:0 10px 30px rgba(183,255,0,.2);
    }


    /* ================================
       HERO
    ================================= */

    .course-hero{
      position:relative;
      overflow:hidden;

      padding:100px 0;

      background:
        radial-gradient(
          circle at 80% 30%,
          rgba(183,255,0,.14),
          transparent 30%
        ),
        #050505;
    }

    .course-hero-grid{
      display:grid;

      grid-template-columns:
        1.05fr .95fr;

      align-items:center;

      gap:70px;
    }

    .badge{
      display:inline-flex;

      padding:8px 15px;

      margin-bottom:22px;

      border:1px solid rgba(183,255,0,.25);

      border-radius:50px;

      color:#b7ff00;

      background:rgba(183,255,0,.06);

      font-size:11px;
      font-weight:800;
      letter-spacing:1px;
    }

    .course-hero h1{
      font-size:clamp(45px,6vw,75px);

      line-height:1.05;

      letter-spacing:-3px;

      margin-bottom:22px;
    }

    .course-hero h1 span{
      color:#b7ff00;
    }

    .course-hero-text{
      max-width:650px;

      color:#999;

      font-size:17px;

      line-height:1.8;

      margin-bottom:30px;
    }

    .hero-buttons{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
    }

    .btn{
      display:inline-flex;

      align-items:center;
      justify-content:center;

      padding:14px 23px;

      border-radius:9px;

      font-size:14px;
      font-weight:800;

      transition:.3s;
    }

    .primary{
      background:#b7ff00;
      color:#050505;
    }

    .primary:hover{
      transform:translateY(-3px);
      box-shadow:0 12px 35px rgba(183,255,0,.2);
    }

    .secondary{
      border:1px solid #333;
      color:#fff;
    }

    .secondary:hover{
      border-color:#b7ff00;
      color:#b7ff00;
    }


    /* ================================
       COURSE IMAGE
    ================================= */

    .course-hero-image{
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .course-image-box{
      width:min(480px,100%);

      padding:25px;

      border:1px solid rgba(183,255,0,.2);

      border-radius:24px;

      background:
        radial-gradient(
          circle at center,
          rgba(183,255,0,.10),
          #0b0b0b 65%
        );

      box-shadow:
        0 0 80px rgba(183,255,0,.07);
    }

    .course-image-box img{
      width:100%;
      height:auto;

      border-radius:15px;
    }


    /* ================================
       COURSE INFO
    ================================= */

    .course-info-bar{
      background:#090909;

      border-top:1px solid #1b1b1b;
      border-bottom:1px solid #1b1b1b;
    }

    .info-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
    }

    .info-item{
      padding:25px 15px;

      text-align:center;

      border-right:1px solid #1b1b1b;
    }

    .info-item:last-child{
      border-right:0;
    }

    .info-item strong{
      display:block;

      color:#b7ff00;

      font-size:20px;

      margin-bottom:4px;
    }

    .info-item span{
      color:#777;
      font-size:12px;
    }


    /* ================================
       COMMON SECTION
    ================================= */

    .section{
      padding:100px 0;
    }

    .section-title{
      max-width:750px;

      margin-bottom:50px;
    }

    .section-title small{
      display:block;

      color:#b7ff00;

      font-size:11px;
      font-weight:800;

      letter-spacing:2px;

      margin-bottom:12px;
    }

    .section-title h2{
      font-size:clamp(35px,5vw,55px);

      line-height:1.1;

      letter-spacing:-2px;

      margin-bottom:15px;
    }

    .section-title h2 span{
      color:#b7ff00;
    }

    .section-title p{
      color:#888;

      font-size:15px;

      line-height:1.8;
    }


    /* ================================
       COURSE OVERVIEW
    ================================= */

    .overview{
      background:#050505;
    }

    .overview-grid{
      display:grid;

      grid-template-columns:
        1fr 1fr;

      gap:20px;
    }

    .overview-card{
      padding:30px;

      background:#0c0c0c;

      border:1px solid #202020;

      border-radius:18px;
    }

    .overview-card h3{
      color:#fff;

      font-size:21px;

      margin-bottom:12px;
    }

    .overview-card p{
      color:#858585;

      font-size:14px;

      line-height:1.8;
    }


    /* ================================
       WHAT YOU WILL LEARN
    ================================= */

    .learn{
      background:#080808;
    }

    .learn-grid{
      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:15px;
    }

    .learn-item{
      display:flex;
      align-items:flex-start;

      gap:15px;

      padding:22px;

      background:#101010;

      border:1px solid #222;

      border-radius:14px;
    }

    .learn-icon{
      width:40px;
      height:40px;

      flex-shrink:0;

      display:grid;
      place-items:center;

      color:#050505;

      background:#b7ff00;

      border-radius:10px;

      font-weight:900;
    }

    .learn-item h3{
      font-size:16px;

      margin-bottom:4px;
    }

    .learn-item p{
      color:#777;

      font-size:13px;
    }


    /* ================================
       COURSE MODULES
    ================================= */

    .modules{
      background:#050505;
    }

    .module-list{
      display:grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:15px;
    }

    .module{
      padding:25px;

      background:#0b0b0b;

      border:1px solid #202020;

      border-radius:16px;
    }

    .module-number{
      color:#b7ff00;

      font-size:11px;
      font-weight:800;

      letter-spacing:1px;

      margin-bottom:10px;
    }

    .module h3{
      font-size:18px;

      margin-bottom:8px;
    }

    .module p{
      color:#777;

      font-size:13px;

      line-height:1.7;
    }


    /* ================================
       PRICE CTA
    ================================= */

    .price-section{
      padding:100px 0;

      background:
        radial-gradient(
          circle at center,
          rgba(183,255,0,.12),
          transparent 45%
        ),
        #050505;

      text-align:center;
    }

    .price-section small{
      display:block;

      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:2px;

      margin-bottom:12px;
    }

    .price-section h2{
      font-size:clamp(35px,5vw,55px);

      margin-bottom:15px;
    }

    .price{
      display:flex;

      align-items:center;
      justify-content:center;

      gap:12px;

      margin:20px 0 30px;
    }

    .price del{
      color:#555;
      font-size:18px;
    }

    .price strong{
      color:#b7ff00;
      font-size:40px;
    }


    /* ================================
       FOOTER
    ================================= */

    .footer{
      padding:40px 0;

      border-top:1px solid #1b1b1b;

      background:#050505;
    }

    .footer-inner{
      display:flex;

      justify-content:space-between;

      align-items:center;

      gap:20px;
    }

    .footer-brand{
      font-size:18px;
      font-weight:800;
    }

    .footer-brand span{
      color:#b7ff00;
    }

    .footer-tagline{
      color:#666;
      font-size:12px;
    }

    .copyright{
      color:#666;
      font-size:12px;
    }


    /* ================================
       RESPONSIVE
    ================================= */

    @media(max-width:900px){

      .menu{
        display:none;
      }

      .course-hero-grid{
        grid-template-columns:1fr;

        text-align:center;

        gap:45px;
      }

      .course-hero-text{
        margin-left:auto;
        margin-right:auto;
      }

      .hero-buttons{
        justify-content:center;
      }

      .course-hero-image{
        max-width:500px;
        margin:auto;
      }

      .module-list{
        grid-template-columns:repeat(2,1fr);
      }

    }


    @media(max-width:700px){

      .nav{
        min-height:70px;
      }

      .brand img{
        width:105px;
      }

      .nav-button{
        padding:9px 13px;
        font-size:11px;
      }

      .course-hero{
        padding:70px 0;
      }

      .course-hero h1{
        font-size:45px;
        letter-spacing:-2px;
      }

      .course-hero-text{
        font-size:15px;
      }

      .hero-buttons{
        flex-direction:column;
      }

      .hero-buttons .btn{
        width:100%;
      }

      .info-grid{
        grid-template-columns:repeat(2,1fr);
      }

      .info-item{
        border-bottom:1px solid #1b1b1b;
      }

      .info-item:nth-child(2){
        border-right:0;
      }

      .info-item:nth-child(3){
        border-bottom:0;
      }

      .info-item:nth-child(4){
        border-right:0;
        border-bottom:0;
      }

      .section{
        padding:75px 0;
      }

      .overview-grid,
      .learn-grid{
        grid-template-columns:1fr;
      }

      .module-list{
        grid-template-columns:1fr;
      }

      .price-section{
        padding:75px 0;
      }

      .footer-inner{
        flex-direction:column;
        align-items:flex-start;
      }

    }

  </style>
</head>


