  <style>

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html{
      scroll-behavior:smooth;
    }

    body{
      font-family:Arial, Helvetica, sans-serif;
      background:#050505;
      color:#fff;
      line-height:1.7;
    }

    a{
      text-decoration:none;
      color:inherit;
    }

    .container{
      width:min(1150px,92%);
      margin:auto;
    }


    /* =========================
       HEADER
    ========================= */

    .header{
      position:sticky;
      top:0;
      z-index:9999;

      background:rgba(5,5,5,.92);
      backdrop-filter:blur(15px);

      border-bottom:1px solid #1d1d1d;
    }

    .nav{
      min-height:78px;

      display:flex;
      align-items:center;
      justify-content:space-between;

      gap:20px;
    }

    .brand img{
      width:115px;
      display:block;
    }

    .menu{
      display:flex;
      align-items:center;
      gap:25px;
    }

    .menu a{
      color:#aaa;
      font-size:14px;
      transition:.3s;
    }

    .menu a:hover{
      color:#b7ff00;
    }

    .nav-button{
      background:#b7ff00;
      color:#050505;

      padding:10px 17px;

      border-radius:8px;

      font-size:13px;
      font-weight:800;
    }


    /* =========================
       HERO
    ========================= */

    .course-hero{
      position:relative;
      overflow:hidden;

      padding:100px 0 90px;

      background:
        radial-gradient(
          circle at 80% 30%,
          rgba(183,255,0,.13),
          transparent 30%
        ),
        #050505;
    }

    .course-hero-grid{
      display:grid;

      grid-template-columns:
        1.1fr .9fr;

      align-items:center;

      gap:70px;
    }

    .tag{
      display:inline-block;

      padding:7px 13px;

      margin-bottom:20px;

      color:#b7ff00;

      border:1px solid rgba(183,255,0,.25);

      background:rgba(183,255,0,.06);

      border-radius:50px;

      font-size:11px;
      font-weight:800;
      letter-spacing:1px;
    }

    .course-hero h1{
      font-size:clamp(42px,6vw,72px);

      line-height:1.05;

      letter-spacing:-3px;

      margin-bottom:22px;
    }

    .course-hero h1 span{
      color:#b7ff00;
    }

    .course-hero p{
      max-width:650px;

      color:#999;

      font-size:17px;

      line-height:1.85;

      margin-bottom:30px;
    }


    /* =========================
       HERO IMAGE
    ========================= */

    .hero-course-image{
      display:flex;
      justify-content:center;
      align-items:center;
    }

    .hero-course-image img{
      width:100%;
      max-width:450px;

      display:block;

      border-radius:22px;

      border:1px solid rgba(183,255,0,.18);

      box-shadow:
        0 30px 80px rgba(0,0,0,.5);
    }


    /* =========================
       BUTTONS
    ========================= */

    .buttons{
      display:flex;
      flex-wrap:wrap;
      gap:12px;
    }

    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;

      padding:13px 22px;

      border-radius:9px;

      font-size:14px;
      font-weight:800;

      transition:.3s;
    }

    .primary{
      background:#b7ff00;
      color:#050505;
    }

    .primary:hover{
      transform:translateY(-3px);

      box-shadow:
        0 12px 30px rgba(183,255,0,.2);
    }

    .secondary{
      border:1px solid #333;
      color:#fff;
    }

    .secondary:hover{
      border-color:#b7ff00;
      color:#b7ff00;
    }


    /* =========================
       COURSE INFO
    ========================= */

    .course-info-bar{
      background:#090909;

      border-top:1px solid #1c1c1c;
      border-bottom:1px solid #1c1c1c;
    }

    .info-grid{
      display:grid;
      grid-template-columns:repeat(4,1fr);
    }

    .info-box{
      padding:25px 18px;

      text-align:center;

      border-right:1px solid #1c1c1c;
    }

    .info-box:last-child{
      border-right:0;
    }

    .info-box strong{
      display:block;

      color:#b7ff00;

      font-size:21px;

      margin-bottom:3px;
    }

    .info-box span{
      color:#777;
      font-size:12px;
    }


    /* =========================
       COMMON SECTION
    ========================= */

    .section{
      padding:90px 0;
    }

    .section-title{
      max-width:720px;

      margin-bottom:45px;
    }

    .section-title small{
      display:block;

      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:2px;

      margin-bottom:12px;
    }

    .section-title h2{
      font-size:clamp(34px,5vw,52px);

      line-height:1.1;

      letter-spacing:-2px;

      margin-bottom:15px;
    }

    .section-title h2 span{
      color:#b7ff00;
    }

    .section-title p{
      color:#888;

      font-size:15px;

      line-height:1.8;
    }


    /* =========================
       OVERVIEW
    ========================= */

    .overview{
      background:#080808;
    }

    .overview-grid{
      display:grid;

      grid-template-columns:
        1fr 1fr;

      gap:20px;
    }

    .overview-card{
      padding:30px;

      background:#101010;

      border:1px solid #222;

      border-radius:16px;
    }

    .overview-card h3{
      font-size:21px;

      margin-bottom:12px;
    }

    .overview-card p{
      color:#888;

      font-size:14px;

      line-height:1.8;
    }


    /* =========================
       WHAT YOU WILL LEARN
    ========================= */

    .learn-list{
      display:grid;

      grid-template-columns:
        repeat(2,1fr);

      gap:15px;
    }

    .learn-item{
      display:flex;
      align-items:flex-start;

      gap:15px;

      padding:20px;

      background:#0c0c0c;

      border:1px solid #202020;

      border-radius:13px;
    }

    .check{
      width:32px;
      height:32px;

      flex-shrink:0;

      display:grid;
      place-items:center;

      background:rgba(183,255,0,.1);

      color:#b7ff00;

      border-radius:8px;

      font-weight:900;
    }

    .learn-item h3{
      font-size:16px;

      margin-bottom:3px;
    }

    .learn-item p{
      color:#777;

      font-size:12px;
    }


    /* =========================
       COURSE MODULES
    ========================= */

    .modules{
      background:#080808;
    }

    .module-grid{
      display:grid;

      grid-template-columns:
        repeat(3,1fr);

      gap:18px;
    }

    .module{
      padding:25px;

      background:#101010;

      border:1px solid #222;

      border-radius:15px;
    }

    .module-number{
      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:1px;

      margin-bottom:10px;
    }

    .module h3{
      font-size:18px;

      margin-bottom:9px;
    }

    .module p{
      color:#777;

      font-size:13px;
    }


    /* =========================
       PRICE
    ========================= */

    .price-section{
      padding:90px 0;

      background:
        radial-gradient(
          circle at center,
          rgba(183,255,0,.08),
          transparent 45%
        );
    }

    .price-card{
      max-width:600px;

      margin:auto;

      padding:45px 35px;

      text-align:center;

      background:#0d0d0d;

      border:1px solid rgba(183,255,0,.25);

      border-radius:20px;

      box-shadow:
        0 25px 70px rgba(0,0,0,.35);
    }

    .price-card small{
      color:#b7ff00;

      font-size:11px;

      font-weight:800;

      letter-spacing:2px;
    }

